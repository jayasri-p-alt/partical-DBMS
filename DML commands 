-- Create a table
CREATE TABLE Student (
    ID INT,
    Name VARCHAR(50),
    Age INT
);

-- 1. INSERT: Add new records
INSERT INTO Student VALUES (1, 'Jayasri', 20);

-- 2. UPDATE: Modify existing data
UPDATE Student
SET Age = 21
WHERE ID = 1;

-- 3. DELETE: Delete a record
DELETE FROM Student
WHERE ID = 1;

-- 4. SELECT: Display records
SELECT * FROM Student;